soong_namespace {
}

cc_defaults {
    name: "motorola_dolby_prebuilt_defaults",
    compile_multilib: "64",
    owner: "dolby",
    soc_specific: true,
    strip: {
        none: true,
    },
}

cc_prebuilt_library_shared {
    name: "libcodec2_soft_ac4dec",
    defaults: ["motorola_dolby_prebuilt_defaults"],
    srcs: ["proprietary/vendor/lib64/libcodec2_soft_ac4dec.so"],
    shared_libs: [
        "libbase",
        "libc",
        "libc++",
        "libcodec2",
        "libcodec2_soft_common",
        "libcodec2_store_dolby",
        "libcodec2_vndk",
        "libcutils",
        "libdeccfg",
        "libdl",
        "libdmshal",
        "liblog",
        "libm",
        "libstagefright_foundation",
        "libutils",
    ],
}

